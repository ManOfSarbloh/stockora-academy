{
  "name": "stockora-academy",
  "version": "0.1.0",
  "private": true,
  "description": "Stockora Academy: a free, educational website about stocks, trading and stock markets worldwide.",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && pagefind --site dist",
    "preview": "astro preview",
    "check": "astro check",
    "validate": "node scripts/validate-content.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run validate && npm run check && npm run test && npm run build",
    "check:videos": "node scripts/check-videos.js",
    "build:chart-images": "node scripts/build-chart-images.mjs",
    "check:videos:write": "node scripts/check-videos.js --write",
    "verify:full": "npm run verify && npm run check:videos"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.2",
    "@astrojs/react": "7.0.1",
    "@astrojs/sitemap": "3.7.4",
    "@fontsource-variable/inter": "5.3.0",
    "@tailwindcss/typography": "0.5.20",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwindcss": "4.3.3",
    "unist-util-visit": "5.1.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@types/d3-geo": "^3.1.1",
    "@types/hast": "^3.0.5",
    "@types/mdast": "^4.0.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/topojson-client": "^3.1.5",
    "d3-geo": "^3.1.1",
    "pagefind": "1.5.2",
    "rehype-stringify": "^10.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "topojson-client": "^3.1.0",
    "typescript": "6.0.3",
    "unified": "^11.0.5",
    "vitest": "5.0.3",
    "world-atlas": "^2.0.2",
    "yaml": "^2.9.1"
  }
}
