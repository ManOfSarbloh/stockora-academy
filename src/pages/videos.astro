---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/PageHeader.astro';
import VideoCard from '@/components/VideoCard.astro';
import { getCategories } from '@/lib/categories';
import { countryHref, getCountries } from '@/lib/countries';
import { t, type UiKey } from '@/i18n';
import { url } from '@/lib/url';

const categories = await getCategories();
const countries = await getCountries();
const names = new Map<string, { label: string; href: string }>([
  ...categories.map((c) => [c.id, { label: c.title, href: `/learn/${c.slug}` }] as const),
  ...countries.map((c) => [c.code, { label: c.name, href: countryHref(c.code) }] as const),
]);
const order = [...categories.map((c) => c.id), ...countries.map((c) => c.code)];
const rank = (v: { categories: string[] }) => Math.min(...v.categories.map((c) => (order.includes(c) ? order.indexOf(c) : 999)));
const videos = (await getCollection('videos')).map((v) => v.data).sort((a, b) => rank(a) - rank(b) || a.title.localeCompare(b.title));

const used = new Set(videos.flatMap((v) => v.categories));
const topicOptions = categories.filter((c) => used.has(c.id));
const countryOptions = countries.filter((c) => used.has(c.code));
const languages = [...new Set(videos.map((v) => v.language))].sort((a, b) => (a === 'en' ? -1 : b === 'en' ? 1 : a.localeCompare(b)));
const langLabel = (l: string) => t(`lang.${l}` as UiKey) ?? l.toUpperCase();
const lengthBucket = (m: number) => (m <= 5 ? 'short' : m <= 15 ? 'medium' : m <= 30 ? 'long' : 'lecture');
---

<BaseLayout title={t('vl.title')} description={t('vl.lead')}>
  <PageHeader title={t('vl.title')} lead={t('vl.lead')}>
    <p class="mt-3 text-sm text-muted">{t('video.disclaimer')}</p>
  </PageHeader>

  <div class="container-page py-10">
    <form id="vl-filters" class="card grid gap-4 p-5 sm:grid-cols-2 lg:grid-cols-6" aria-label={t('vl.filters')} data-count={t('vl.count', { shown: '{shown}', total: '{total}' })}>
      <label class="text-sm font-semibold lg:col-span-2">
        {t('vl.search')}
        <input
          type="search"
          name="q"
          class="mt-1.5 block w-full rounded-lg border border-border bg-surface px-3 py-1.5 font-normal text-text"
          autocomplete="off"
        />
      </label>
      <label class="text-sm font-semibold">
        {t('vl.topic')}
        <select name="topic" class="mt-1.5 block w-full rounded-lg border border-border bg-surface px-2 py-1.5 font-normal text-text">
          <option value="">{t('vl.allTopics')}</option>
          <optgroup label={t('vl.topicsGroup')}>
            {topicOptions.map((c) => <option value={c.id}>{c.title}</option>)}
          </optgroup>
          <optgroup label={t('vl.countriesGroup')}>
            {countryOptions.map((c) => <option value={c.code}>{c.name}</option>)}
          </optgroup>
        </select>
      </label>
      <label class="text-sm font-semibold">
        {t('vl.level')}
        <select name="level" class="mt-1.5 block w-full rounded-lg border border-border bg-surface px-2 py-1.5 font-normal text-text">
          <option value="">{t('vl.allLevels')}</option>
          {(['beginner', 'intermediate', 'advanced'] as const).map((l) => <option value={l}>{t(`level.${l}`)}</option>)}
        </select>
      </label>
      <label class="text-sm font-semibold">
        {t('vl.language')}
        <select name="lang" class="mt-1.5 block w-full rounded-lg border border-border bg-surface px-2 py-1.5 font-normal text-text">
          <option value="">{t('vl.allLanguages')}</option>
          {languages.map((l) => <option value={l}>{langLabel(l)}</option>)}
        </select>
      </label>
      <label class="text-sm font-semibold">
        {t('vl.length')}
        <select name="len" class="mt-1.5 block w-full rounded-lg border border-border bg-surface px-2 py-1.5 font-normal text-text">
          <option value="">{t('vl.anyLength')}</option>
          {(['short', 'medium', 'long', 'lecture'] as const).map((b) => <option value={b}>{t(`vl.len.${b}` as UiKey)}</option>)}
        </select>
      </label>
      <div class="flex items-end gap-3 sm:col-span-2 lg:col-span-6">
        <p id="vl-count" class="text-sm text-muted" aria-live="polite">{t('vl.count', { shown: videos.length, total: videos.length })}</p>
        <button type="reset" class="ml-auto text-sm text-link underline">{t('vl.reset')}</button>
      </div>
    </form>

    <ul id="vl-list" class="mt-6 grid gap-5 md:grid-cols-2 xl:grid-cols-3">
      {
        videos.map((v) => (
          <li
            data-topics={v.categories.join(' ')}
            data-level={v.level}
            data-lang={v.language}
            data-len={lengthBucket(v.durationMinutes)}
            data-text={`${v.title} ${v.channel}`.toLowerCase()}
          >
            <VideoCard video={v} />
            <p class="mt-2 flex flex-wrap gap-1.5 text-xs">
              <span class="text-muted">{t('vl.shownOn')}:</span>
              {v.categories
                .filter((c) => names.has(c))
                .map((c) => (
                  <a href={url(names.get(c)!.href)} class="rounded-full bg-surface-2 px-2 py-0.5 text-muted no-underline hover:text-link">
                    {names.get(c)!.label}
                  </a>
                ))}
            </p>
          </li>
        ))
      }
    </ul>
    <p id="vl-none" class="card mt-6 hidden p-5 text-muted">{t('vl.none')}</p>

    <section class="mt-12 max-w-3xl" aria-labelledby="vl-rules-title">
      <h2 id="vl-rules-title" class="text-xl font-bold">{t('vl.rules')}</h2>
      <ul class="mt-3 list-disc space-y-1.5 pl-5 text-muted">
        <li>{t('vl.rule1')}</li>
        <li>{t('vl.rule2')}</li>
        <li>{t('vl.rule3')}</li>
        <li>{t('vl.rule4')}</li>
      </ul>
    </section>
  </div>
</BaseLayout>

<script>
  const form = document.getElementById('vl-filters') as HTMLFormElement;
  const items = [...document.querySelectorAll<HTMLLIElement>('#vl-list > li')];
  const count = document.getElementById('vl-count')!;
  const none = document.getElementById('vl-none')!;
  const template = form.dataset.count ?? '{shown} / {total}';

  function apply() {
    const f = new FormData(form);
    const q = String(f.get('q') ?? '').trim().toLowerCase();
    const topic = String(f.get('topic') ?? '');
    const level = String(f.get('level') ?? '');
    const lang = String(f.get('lang') ?? '');
    const len = String(f.get('len') ?? '');
    let shown = 0;
    for (const li of items) {
      const d = li.dataset;
      const ok =
        (!topic || (d.topics ?? '').split(' ').includes(topic)) &&
        (!level || d.level === level) &&
        (!lang || d.lang === lang) &&
        (!len || d.len === len) &&
        (!q || (d.text ?? '').includes(q));
      li.hidden = !ok;
      if (ok) shown++;
    }
    count.textContent = template.replace('{shown}', String(shown)).replace('{total}', String(items.length));
    none.classList.toggle('hidden', shown > 0);
    // Keep the filters in the URL so a filtered view can be bookmarked or shared.
    const params = new URLSearchParams();
    for (const [k, v] of f.entries()) if (String(v)) params.set(k, String(v));
    history.replaceState(null, '', params.size ? `?${params}` : location.pathname);
  }

  // Restore filters from the URL (e.g. /videos?topic=J).
  const initial = new URLSearchParams(location.search);
  for (const [k, v] of initial.entries()) {
    const el = form.elements.namedItem(k) as HTMLInputElement | HTMLSelectElement | null;
    if (el) el.value = v;
  }
  form.addEventListener('input', apply);
  form.addEventListener('change', apply);
  form.addEventListener('submit', (e) => e.preventDefault());
  form.addEventListener('reset', () => setTimeout(apply));
  apply();
</script>
