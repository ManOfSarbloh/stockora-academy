---
import { withLocales } from '@/i18n/pages';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/PageHeader.astro';
import { topicIcon } from '@/components/art/icons';
import VideoList from '@/components/VideoList.astro';
import QuizSection from '@/components/quiz/QuizSection.astro';
import { getCategories, type Category } from '@/lib/categories';
import { getLessonSequence, type LessonRef } from '@/lib/lessons';
import { t } from '@/i18n';
import { absoluteUrl, url } from '@/lib/url';
import * as seo from '@/lib/seo';

export async function getStaticPaths() {
  const [categories, seq] = await Promise.all([getCategories(), getLessonSequence()]);
  return withLocales(categories.map((category, i) => ({
    params: { category: category.slug },
    props: {
      category,
      lessons: seq.filter((l) => l.category.id === category.id),
      prev: categories[i - 1],
      next: categories[i + 1],
    },
  })));
}

interface Props {
  category: Category;
  lessons: LessonRef[];
  prev?: Category;
  next?: Category;
}

const { category: c, lessons, prev, next } = Astro.props;
---

<BaseLayout
  title={c.title}
  description={c.summary}
  jsonLd={seo.breadcrumbs([
    { name: t('learn.title'), url: absoluteUrl('/learn', Astro.site) },
    { name: `${c.id}. ${c.title}`, url: absoluteUrl(`/learn/${c.slug}`, Astro.site) },
  ])}
>
  <PageHeader art={topicIcon(c.id)} title={c.title} lead={c.summary} eyebrow={`${t('learn.title')} · ${c.id}`}>
    <div class="mt-5 flex flex-wrap items-center gap-4">
      {lessons[0] && <a href={url(lessons[0].href)} class="btn btn-primary">{t('learn.startTopic')}</a>}
      <a href={url('/learn')} class="text-sm font-medium">← {t('learn.backToTopics')}</a>
    </div>
  </PageHeader>

  <div class="container-page py-10">
    <h2 class="text-xl font-bold">{t('learn.lessons')}</h2>
    {
      lessons.length === 0 ? (
        <p class="card mt-4 p-5 text-muted">{t('learn.noLessons')}</p>
      ) : (
        <ol class="mt-4 max-w-3xl space-y-3">
          {lessons.map((l, i) => (
            <li>
              <a href={url(l.href)} class="card group flex items-start gap-4 p-4 text-text no-underline hover:border-link" data-lesson-key={l.key}>
                <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full border-2 border-border text-sm font-semibold text-muted">
                  <span class="lesson-num">{i + 1}</span>
                  <svg class="lesson-tick hidden h-4 w-4 text-link" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 12 5 5 9-10"></path></svg>
                </span>
                <span class="min-w-0">
                  <span class="block font-semibold group-hover:text-link">{l.title}</span>
                  <span class="mt-1 block text-sm text-muted">{l.entry.data.summary}</span>
                  <span class="mt-2 block text-xs text-muted">
                    {t(`level.${l.entry.data.level}`)} · {t('learn.readingTime', { n: l.entry.data.readingTime })}
                    <span class="lesson-done-label sr-only"></span>
                  </span>
                </span>
              </a>
            </li>
          ))}
        </ol>
      )
    }

    <div class="mt-14 max-w-3xl space-y-14">
      <QuizSection categoryId={c.id} />
      <VideoList categoryId={c.id} fallbackQuery={`${c.title} explained`} />
    </div>

    <nav class="mt-12 flex flex-wrap justify-between gap-4 border-t border-border pt-6 text-sm" aria-label={t('a11y.topicNav')}>
      {prev ? <a href={url(`/learn/${prev.slug}`)}>← {prev.id}. {prev.title}</a> : <span></span>}
      {next && <a href={url(`/learn/${next.slug}`)}>{next.id}. {next.title} →</a>}
    </nav>
  </div>
</BaseLayout>

<script>
  import { loadProgress } from '@/lib/progress';

  const progress = loadProgress();
  for (const el of document.querySelectorAll<HTMLElement>('[data-lesson-key]')) {
    if (!(el.dataset.lessonKey! in progress.done)) continue;
    el.querySelector('.lesson-num')?.classList.add('hidden');
    el.querySelector('.lesson-tick')?.classList.remove('hidden');
    const label = el.querySelector('.lesson-done-label');
    if (label) label.textContent = '(done)';
  }
</script>
