---
import { localeParams } from '@/i18n/pages';

export const getStaticPaths = () => localeParams();
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/PageHeader.astro';
import { TOOLS, TOOL_GROUPS } from '@/config/tools';
import { t, type UiKey } from '@/i18n';
import { url } from '@/lib/url';
---

<BaseLayout title={t('tools.title')} description={t('tools.lead')}>
  <PageHeader title={t('tools.title')} lead={t('tools.lead')}>
    <p class="mt-3 text-sm text-muted">{t('tools.disclaimer')}</p>
  </PageHeader>
  <div class="container-page space-y-12 py-10">
    {
      TOOL_GROUPS.map((g) => (
        <section aria-labelledby={`group-${g}`}>
          <h2 id={`group-${g}`} class="text-2xl font-bold tracking-tight">
            {t(`tools.group.${g}` as UiKey)}
          </h2>
          <ul class="mt-5 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
            {TOOLS.filter((tool) => tool.group === g).map((tool) => (
              <li>
                <a href={url(tool.href ?? `/tools/${tool.slug}`)} class="card flex h-full gap-4 p-5 no-underline transition-colors hover:border-link">
                  <span class="text-3xl" aria-hidden="true">
                    {tool.icon}
                  </span>
                  <span>
                    <span class="block font-semibold text-text">{t(`tools.t.${tool.slug}` as UiKey)}</span>
                    <span class="mt-1 block text-sm text-muted">{t(`tools.d.${tool.slug}` as UiKey)}</span>
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </div>
</BaseLayout>
