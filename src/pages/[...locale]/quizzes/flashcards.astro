---
import { localeParams } from '@/i18n/pages';

export const getStaticPaths = () => localeParams();
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/PageHeader.astro';
import Flashcards from '@/components/quiz/Flashcards';
import { getQuizMeta } from '@/lib/quiz-meta';
import { t } from '@/i18n';
import { url } from '@/lib/url';

const meta = await getQuizMeta();
---

<BaseLayout title={t('fc.title')} description={t('fc.lead')}>
  <PageHeader title={t('fc.title')} lead={t('fc.lead')}>
    <p class="mt-3 text-sm"><a href={url('/quizzes')}>← {t('quiz.toHub')}</a></p>
  </PageHeader>
  <div class="container-page max-w-3xl py-10" data-pagefind-ignore>
    <Flashcards client:only="react" names={meta.names} topics={meta.topics} countries={meta.countries}>
      <div slot="fallback" class="island-fallback h-[340px] lg:h-[285px]"></div>
    </Flashcards>
    <noscript><p class="card p-4 text-muted">{t('js.flashcards')}</p></noscript>
  </div>
</BaseLayout>
