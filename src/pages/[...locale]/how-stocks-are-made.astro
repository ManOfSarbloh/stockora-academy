---
import { localeParams } from '@/i18n/pages';

export const getStaticPaths = () => localeParams();
/**
 * "How Stocks Are Made": the journey of a share in nine steps, with simulators, a mini-quiz per
 * step, case studies, a play-money game and a special quiz. All text lives in
 * content/how-stocks-are-made/ (steps and case studies) and content/quizzes/HSM-*.json.
 */
import { getCollection, render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/PageHeader.astro';
import QuizSection from '@/components/quiz/QuizSection.astro';
import CapTableSimulator from '@/components/tools/CapTableSimulator';
import BookbuildingSimulator from '@/components/tools/BookbuildingSimulator';
import FounderGame from '@/components/tools/FounderGame';
import { getLessonSequence } from '@/lib/lessons';
import { t } from '@/i18n';
import { url } from '@/lib/url';

const steps = (await getCollection('journeySteps')).sort((a, b) => a.data.step - b.data.step);
const cases = (await getCollection('caseStudies')).sort((a, b) => a.data.order - b.data.order);
const lessonsByKey = new Map((await getLessonSequence()).map((l) => [l.key, l]));

const renderedSteps = await Promise.all(steps.map(async (s) => ({ entry: s, Content: (await render(s)).Content })));
const renderedCases = await Promise.all(cases.map(async (c) => ({ entry: c, Content: (await render(c)).Content })));
const lastReviewed = [...steps, ...cases].map((e) => e.data.lastReviewed).sort().pop();
---

<BaseLayout title={t('hsm.title')} description={t('hsm.lead')}>
  <PageHeader title={t('hsm.title')} lead={t('hsm.lead')} eyebrow={t('hsm.eyebrow')}>
    <p class="mt-4 text-sm text-muted">
      {t('learn.lastReviewed')}: <time datetime={lastReviewed}>{lastReviewed}</time> ·
      <a href="#case-studies">{t('hsm.cases.title')}</a> ·
      <a href="#game">{t('hsm.game.title')}</a> ·
      <a href="#quiz">{t('hsm.quiz.title')}</a>
    </p>
  </PageHeader>

  <div class="container-page py-10">
    {/* ---- Pipeline overview ---- */}
    <nav aria-labelledby="pipeline-title" data-pagefind-ignore>
      <h2 id="pipeline-title" class="text-xl font-bold">{t('hsm.pipeline')}</h2>
      <ol class="mt-4 grid grid-cols-2 gap-2 sm:grid-cols-3 lg:grid-cols-9">
        {
          steps.map((s, i) => (
            <li class="relative">
              <a
                href={`#step-${s.data.step}`}
                class="card flex h-full flex-col gap-1 p-3 text-text no-underline transition-colors hover:border-link lg:items-center lg:text-center"
              >
                <span class="flex size-7 items-center justify-center rounded-full bg-navy text-sm font-bold text-on-navy dark:bg-teal dark:text-[#0b1622]">
                  {s.data.step}
                </span>
                <span class="text-sm leading-tight font-semibold">{s.data.short}</span>
              </a>
              {i < steps.length - 1 && (
                <span class="absolute top-1/2 -right-2 z-10 hidden -translate-y-1/2 text-muted lg:block" aria-hidden="true">
                  ›
                </span>
              )}
            </li>
          ))
        }
      </ol>
      <p class="mt-3 max-w-3xl text-sm text-muted">{t('hsm.pipelineLead')}</p>
    </nav>

    {/* ---- Steps ---- */}
    <div class="mt-12 space-y-16">
      {
        renderedSteps.map(({ entry, Content }) => {
          const d = entry.data;
          const deeper = d.lessons.map((k) => lessonsByKey.get(k)).filter((l) => l !== undefined);
          return (
            <section id={`step-${d.step}`} class="scroll-mt-24" aria-labelledby={`step-${d.step}-title`}>
              <p class="text-sm font-semibold tracking-wide text-link uppercase">{t('hsm.stepN', { n: d.step, total: steps.length })}</p>
              <h2 id={`step-${d.step}-title`} class="mt-1 text-2xl font-bold tracking-tight text-balance sm:text-3xl">
                {d.title}
              </h2>
              <p class="mt-2 max-w-3xl text-lg text-muted">{d.summary}</p>

              <div class="prose prose-stockora mt-6 max-w-3xl prose-headings:tracking-tight prose-a:font-medium prose-h3:mt-6">
                <Content />
              </div>

              {d.tool === 'cap-table' && (
                <div class="mt-8 max-w-4xl" data-pagefind-ignore>
                  <CapTableSimulator client:only="react">
                    <div slot="fallback" class="island-fallback h-[1300px]"></div>
                  </CapTableSimulator>
                  <noscript>
                    <p class="card p-4 text-muted">{t('hsm.needsJs')}</p>
                  </noscript>
                </div>
              )}
              {d.tool === 'bookbuilding' && (
                <div class="mt-8 max-w-4xl" data-pagefind-ignore>
                  <BookbuildingSimulator client:only="react">
                    <div slot="fallback" class="island-fallback h-[1300px]"></div>
                  </BookbuildingSimulator>
                  <noscript>
                    <p class="card p-4 text-muted">{t('hsm.needsJs')}</p>
                  </noscript>
                </div>
              )}

              <div class="mt-8 grid max-w-4xl gap-6 lg:grid-cols-[minmax(0,1fr)_16rem]">
                <QuizSection
                  lessonLinks={deeper.map((l) => l.href)}
                  limit={3}
                  id={`step-${d.step}-quiz`}
                  quizId={`HSM:step-${d.step}`}
                  lead={t('quiz.stepLead', { n: 3 })}
                  headingLevel={3}
                />
                <aside class="text-sm" data-pagefind-ignore>
                  <h3 class="font-bold">{t('hsm.goDeeper')}</h3>
                  <ul class="mt-2 space-y-1.5">
                    {deeper.map((l) => (
                      <li>
                        <a href={url(l.href)}>{l.title}</a>
                        <span class="block text-xs text-muted">
                          {l.category.id}. {l.category.title}
                        </span>
                      </li>
                    ))}
                  </ul>
                  <details class="mt-4">
                    <summary class="cursor-pointer text-muted">
                      {t('learn.sources')} ({d.sources.length})
                    </summary>
                    <ul class="mt-2 list-disc space-y-1 pl-5">
                      {d.sources.map((s) => (
                        <li>
                          <a href={s.url} rel="noopener">
                            {s.title}
                          </a>
                        </li>
                      ))}
                    </ul>
                  </details>
                </aside>
              </div>
            </section>
          );
        })
      }
    </div>

    {/* ---- Case studies ---- */}
    <section id="case-studies" class="mt-20 scroll-mt-24" aria-labelledby="case-studies-title">
      <h2 id="case-studies-title" class="text-2xl font-bold tracking-tight sm:text-3xl">{t('hsm.cases.title')}</h2>
      <p class="mt-2 max-w-3xl text-muted">{t('hsm.cases.lead')}</p>
      <div class="mt-6 grid gap-5 lg:grid-cols-2">
        {
          renderedCases.map(({ entry, Content }) => (
            <article class="card p-5 sm:p-6" aria-labelledby={`case-${entry.id}`}>
              <p class="text-sm text-muted">
                <span class="font-semibold text-link">{entry.data.year}</span> · {entry.data.place}
              </p>
              <h3 id={`case-${entry.id}`} class="mt-1 text-lg font-bold">
                {entry.data.title}
              </h3>
              <div class="prose prose-stockora prose-sm mt-3 max-w-none prose-a:font-medium prose-table:text-sm">
                <Content />
              </div>
              <details class="mt-4 text-sm" data-pagefind-ignore>
                <summary class="cursor-pointer text-muted">
                  {t('learn.sources')} ({entry.data.sources.length})
                </summary>
                <ul class="mt-2 list-disc space-y-1 pl-5">
                  {entry.data.sources.map((s) => (
                    <li>
                      <a href={s.url} rel="noopener">
                        {s.title}
                      </a>
                    </li>
                  ))}
                </ul>
              </details>
            </article>
          ))
        }
      </div>
    </section>

    {/* ---- Game ---- */}
    <section id="game" class="mt-20 max-w-4xl scroll-mt-24" aria-labelledby="game-title" data-pagefind-ignore>
      <h2 id="game-title" class="text-2xl font-bold tracking-tight sm:text-3xl">{t('hsm.game.title')}</h2>
      <p class="mt-2 max-w-3xl text-muted">{t('hsm.game.lead')}</p>
      <div class="mt-6">
        <FounderGame client:only="react">
          <div slot="fallback" class="island-fallback h-[460px] lg:h-[420px]"></div>
        </FounderGame>
        <noscript>
          <p class="card p-4 text-muted">{t('hsm.needsJs')}</p>
        </noscript>
      </div>
    </section>

    {/* ---- Special quiz ---- */}
    <div class="mt-20 max-w-4xl">
      <QuizSection categoryId="HSM" id="quiz" quizId="HSM" title={t('hsm.quiz.title')} />
    </div>

    <p class="mt-12 max-w-3xl text-sm text-muted">{t('hsm.disclaimer')}</p>
  </div>
</BaseLayout>

<script>
  // Each step and case study is its own Markdown file, so the build links the first mention of a
  // glossary term in every one of them. On this long page, keep only the first link per term.
  const seen = new Set<string>();
  document.querySelectorAll<HTMLAnchorElement>('main a.gloss[data-gloss]').forEach((a) => {
    const id = a.dataset.gloss!;
    if (!seen.has(id)) {
      seen.add(id);
      return;
    }
    a.replaceWith(document.createTextNode(a.textContent ?? ''));
  });
</script>
