---
import { localeParams } from '@/i18n/pages';

export const getStaticPaths = () => localeParams();
/**
 * World Markets comparison page: sortable/filterable tables and "compare two countries".
 * Rows are built from content/countries/*.json and content/world/market-size.json at build time.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/PageHeader.astro';
import Callout from '@/components/Callout.astro';
import CompareWorld, { type CompareRow } from '@/components/world/CompareWorld';
import { getCountries, countryHref, ftseLabel, marketSize, marketSizeSource, marketSizeAsOf, marketSizeMinYear, worldLanguages } from '@/lib/countries';
import { getLessonSequence } from '@/lib/lessons';
import { t } from '@/i18n';
import type { UiKey } from '@/i18n/en';
import { url } from '@/lib/url';

const countries = await getCountries();
const rows: CompareRow[] = countries.map((c) => {
  const s = marketSize(c.code);
  return {
    code: c.code,
    name: c.name,
    href: countryHref(c.code),
    region: c.region,
    regionLabel: t(`tt.region.${c.region}` as UiKey),
    currency: c.currency.code,
    ftse: c.classification.ftse,
    ftseLabel: ftseLabel(c.classification.ftse),
    listedCompanies: s.listedCompanies?.value ?? null,
    listedYear: s.listedCompanies?.year ?? null,
    marketCapUsd: s.marketCapUsd?.value ?? null,
    marketCapYear: s.marketCapUsd?.year ?? null,
    marketCapPctGdp: s.marketCapPctGdp?.value ?? null,
    settlement: c.settlement.cycle,
    csd: c.settlement.csd,
    exchanges: c.exchanges.map((e) => ({ name: e.name, hours: e.hours, timeZone: e.timeZone, hoursSource: e.hoursSource })),
    index: c.indexes[0].name,
    indexConstituents: c.indexes[0].constituents ?? '',
    regulators: c.regulators.map((r) => r.name).join(', '),
    rules: c.rules.map((r) => r.title),
    taxGlance: c.taxes.glance,
    taxAsOf: c.taxes.asOf,
  };
});
const classificationAsOf = countries.map((c) => c.classification.asOf).sort()[0];
const classificationSource = countries[0]?.classification.source;
const classificationLesson = (await getLessonSequence()).find((l) => l.key === 'world-markets/market-classifications');
---

<BaseLayout title={t('wm.compare')} description={t('wm.compare.lead')} availableIn={worldLanguages()}>
  <PageHeader art="compare" title={t('wm.compare')} lead={t('wm.compare.lead')} eyebrow={t('wm.title')}>
    <p class="mt-4 text-sm"><a href={url('/world')}>← {t('wm.allCountries')}</a> · <a href={url('/times')}>{t('nav.times')} →</a></p>
  </PageHeader>

  <div class="container-page py-10">
    <CompareWorld client:load rows={rows} base={url('/')} />
    <noscript>
      <p class="card mt-4 p-4 text-muted">{t('js.compare')}</p>
    </noscript>

    <div class="mt-12 max-w-3xl space-y-4 text-sm">
      <Callout kind="verify" title={t('verify.title')}>
        <p>{t('wm.taxes.verify')} {t('wm.cmp.verifyExtra')}</p>
      </Callout>
      <p class="text-muted">
        <strong>{t('wm.marketSize')}:</strong> {t('wm.cmp.note')} {t('wm.cmp.minYear', { year: marketSizeMinYear })} {t('wm.cmp.source')} <a href={marketSizeSource.url} rel="noopener">{marketSizeSource.title}</a>, {t('wm.cmp.updated', { date: marketSizeAsOf })}.
      </p>
      {
        classificationSource && (
          <p class="text-muted">
            <strong>{t('wm.cmp.classLabel')}:</strong> {t('wm.cmp.classAsOf', { date: classificationAsOf })} <a href={classificationSource.url} rel="noopener">{classificationSource.title}</a>. {t('wm.cmp.msci')}{' '}
            <a href="https://www.msci.com/indexes/index-resources/market-classification" rel="noopener">MSCI Market Classification</a>. {t('wm.cmp.see')}{' '}
            <a href={url('/learn/world-markets/market-classifications')}>{classificationLesson?.title}</a>.
          </p>
        )
      }
      <p class="text-muted">
        <strong>{t('wm.cmp.hoursLabel')}:</strong> <a href={url('/times')}>{t('nav.times')}</a> {t('wm.cmp.hoursText')}
      </p>
    </div>
  </div>
</BaseLayout>
