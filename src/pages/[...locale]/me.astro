---
import { localeParams } from '@/i18n/pages';

export const getStaticPaths = () => localeParams();
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/PageHeader.astro';
import CategoryCard from '@/components/CategoryCard.astro';
import HomeProgress from '@/components/HomeProgress.astro';
import ProgressScript from '@/components/ProgressScript.astro';
import { getCategories } from '@/lib/categories';
import { getLessonKeysByCategory, getLessonSequence } from '@/lib/lessons';
import StudyPlanner from '@/components/StudyPlanner';
import { url } from '@/lib/url';
import { t } from '@/i18n';

const categories = await getCategories();
const keys = await getLessonKeysByCategory();
const withLessons = categories.filter((c) => keys[c.id]?.length);
const sequence = (await getLessonSequence()).map((l) => ({ key: l.key, title: l.title, href: url(l.href) }));
/** Lesson titles and links in this language, so notes saved in another language still show here correctly. */
const lessonIndex = Object.fromEntries(sequence.map((l) => [l.key, { title: l.title, href: l.href }]));
---

<BaseLayout title={t('me.title')} description={t('me.lead')} searchable={false} noindex>
  <PageHeader art="bookmark" title={t('me.title')} lead={t('me.lead')} />
  <div class="container-page py-10">
    <p id="storage-warning" class="callout callout-warning hidden">{t('me.storageNote')}</p>

    <div class="grid items-start gap-4 md:grid-cols-2">
      <HomeProgress />
      <StudyPlanner client:only="react" lessons={sequence}>
        <div slot="fallback" class="island-fallback h-[420px]"></div>
      </StudyPlanner>
    </div>

    <section class="mt-12" aria-labelledby="bookmarks-title">
      <h2 id="bookmarks-title" class="text-xl font-bold">{t('me.bookmarks')}</h2>
      <p id="no-bookmarks" class="card mt-4 p-5 text-muted">{t('me.noBookmarks')}</p>
      <ul id="bookmark-list" class="mt-4 max-w-3xl space-y-2" data-remove-label={t('me.remove')}></ul>
    </section>

    <section id="notes-section" class="mt-12 max-w-3xl" aria-labelledby="notes-list-title">
      <div class="flex flex-wrap items-center justify-between gap-3">
        <h2 id="notes-list-title" class="text-xl font-bold">{t('notes.listTitle')}</h2>
        <button type="button" id="notes-print" class="print-hide btn btn-ghost hidden text-sm">{t('notes.print')}</button>
      </div>
      <p id="no-notes" class="card mt-4 p-5 text-muted">{t('notes.none')}</p>
      <ul id="notes-list" class="mt-4 space-y-3" data-edit={t('notes.edit')}></ul>
      <script type="application/json" id="lesson-index" set:html={JSON.stringify(lessonIndex)} />
    </section>

    {
      withLessons.length > 0 && (
        <section class="mt-12" aria-labelledby="topics-title">
          <h2 id="topics-title" class="text-xl font-bold">{t('me.byTopic')}</h2>
          <ul class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
            {withLessons.map((c) => (
              <li>
                <CategoryCard category={c} lessonKeys={keys[c.id]} />
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <section class="card mt-12 max-w-3xl p-5 sm:p-6" aria-labelledby="backup-title">
      <h2 id="backup-title" class="text-xl font-bold">{t('me.backup.title')}</h2>
      <p class="mt-2 text-muted">{t('me.backup.lead')}</p>
      <div class="mt-4 flex flex-wrap gap-3">
        <button type="button" id="backup-download" class="btn btn-primary">{t('me.backup.download')}</button>
        <label class="btn btn-ghost cursor-pointer">
          {t('me.backup.restore')}
          <input id="backup-file" type="file" accept=".json,application/json" class="sr-only" />
        </label>
      </div>
      <p
        id="backup-status"
        class="mt-3 text-sm font-semibold"
        role="status"
        data-confirm={t('me.backup.confirm')}
        data-done={t('me.backup.done')}
        data-invalid={t('me.backup.invalid')}
        data-empty={t('me.backup.empty')}
        data-nothing={t('me.backup.nothing')}
      >
      </p>
    </section>

    <button type="button" id="reset" class="btn btn-ghost mt-12 text-sm" data-confirm={t('me.resetConfirm')}>
      {t('me.reset')}
    </button>
  </div>
  <ProgressScript />
</BaseLayout>

<script>
  import { BOOKMARKS_KEY, PROGRESS_KEY, loadBookmarks, notifyChange, saveBookmarks, CHANGE_EVENT } from '@/lib/progress';
  import { readAllRaw, remove, replaceAllRaw, STORAGE_PREFIX, writeJSON } from '@/lib/storage';
  import { backupFileName, makeBackup, parseBackup, pickEntries } from '@/lib/backup';
  import { resetQuizData } from '@/lib/quiz-store';
  import { loadNotes, sortedNotes, NOTES_KEY } from '@/lib/notes';

  if (!writeJSON('storage-test', 1)) document.getElementById('storage-warning')?.classList.remove('hidden');
  remove('storage-test');

  const list = document.getElementById('bookmark-list')!;
  const empty = document.getElementById('no-bookmarks')!;

  function renderBookmarks() {
    const items = loadBookmarks();
    empty.classList.toggle('hidden', items.length > 0);
    list.replaceChildren(
      ...items.map((b) => {
        const li = document.createElement('li');
        li.className = 'card flex items-center justify-between gap-3 p-3';
        const a = document.createElement('a');
        a.href = b.href;
        a.textContent = b.title;
        a.className = 'font-medium';
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'rounded-md px-2 py-1 text-sm text-muted hover:bg-surface-2';
        btn.textContent = list.dataset.removeLabel ?? 'Remove';
        btn.setAttribute('aria-label', `${btn.textContent}: ${b.title}`);
        btn.addEventListener('click', () => {
          saveBookmarks(loadBookmarks().filter((x) => x.key !== b.key));
          notifyChange();
        });
        li.append(a, btn);
        return li;
      }),
    );
  }

  document.getElementById('reset')!.addEventListener('click', (e) => {
    const btn = e.currentTarget as HTMLButtonElement;
    if (!window.confirm(btn.dataset.confirm)) return;
    remove(PROGRESS_KEY);
    remove(BOOKMARKS_KEY);
    remove('study-goal');
    remove(NOTES_KEY);
    resetQuizData();
    location.reload();
  });

  // ---- Backup and restore (src/lib/backup.ts) ----
  const status = document.getElementById('backup-status')!;
  const say = (key: 'done' | 'invalid' | 'empty' | 'nothing', ok = false) => {
    status.textContent = status.dataset[key] ?? '';
    status.classList.toggle('text-link', ok);
    status.classList.toggle('text-[#c8352f]', !ok);
    status.classList.toggle('dark:text-[#f87171]', !ok);
  };
  document.getElementById('backup-download')!.addEventListener('click', () => {
    const now = new Date();
    const data = pickEntries(readAllRaw());
    if (!Object.keys(data).length) return say('nothing');
    const blob = new Blob([JSON.stringify(makeBackup(data, now), null, 1)], { type: 'application/json' });
    const a = document.createElement('a');
    a.href = URL.createObjectURL(blob);
    a.download = backupFileName(now);
    document.body.append(a);
    a.click();
    a.remove();
    setTimeout(() => URL.revokeObjectURL(a.href), 1000);
    status.textContent = '';
  });
  const fileInput = document.getElementById('backup-file') as HTMLInputElement;
  fileInput.addEventListener('change', async () => {
    const file = fileInput.files?.[0];
    fileInput.value = '';
    if (!file) return;
    const result = parseBackup(await file.text());
    if (!result.ok) return say(result.error);
    if (!window.confirm(status.dataset.confirm)) return;
    if (!replaceAllRaw(result.data)) return say('invalid');
    say('done', true);
    setTimeout(() => location.reload(), 900);
  });

  // ---- Lesson notes (src/lib/notes.ts) ----
  const notesList = document.getElementById('notes-list')!;
  const noNotes = document.getElementById('no-notes')!;
  const notesPrint = document.getElementById('notes-print')!;
  const lessonIndex = JSON.parse(document.getElementById('lesson-index')!.textContent || '{}') as Record<string, { title: string; href: string }>;
  const when = new Intl.DateTimeFormat(document.documentElement.lang || undefined, { dateStyle: 'medium', timeStyle: 'short' });

  function renderNotes() {
    const notes = sortedNotes(loadNotes());
    noNotes.classList.toggle('hidden', notes.length > 0);
    notesPrint.classList.toggle('hidden', notes.length === 0);
    notesList.replaceChildren(
      ...notes.map((n) => {
        const lesson = lessonIndex[n.key] ?? { title: n.title, href: n.href };
        const li = document.createElement('li');
        li.className = 'card p-4 sm:p-5';
        const head = document.createElement('div');
        head.className = 'flex flex-wrap items-baseline justify-between gap-x-3 gap-y-1';
        const a = document.createElement('a');
        a.href = lesson.href;
        a.textContent = lesson.title;
        a.className = 'font-semibold';
        const time = document.createElement('time');
        time.dateTime = n.updated;
        time.className = 'text-xs text-muted';
        time.textContent = when.format(new Date(n.updated));
        head.append(a, time);
        const text = document.createElement('p');
        text.className = 'mt-2 text-sm whitespace-pre-wrap';
        text.textContent = n.text;
        const edit = document.createElement('a');
        edit.href = `${lesson.href}#notes`;
        edit.className = 'print-hide mt-2 inline-block text-sm font-semibold';
        edit.textContent = notesList.dataset.edit ?? 'Edit';
        edit.setAttribute('aria-label', `${edit.textContent}: ${lesson.title}`);
        li.append(head, text, edit);
        return li;
      }),
    );
  }
  notesPrint.addEventListener('click', () => {
    document.documentElement.classList.add('print-notes');
    window.print();
  });
  window.addEventListener('afterprint', () => document.documentElement.classList.remove('print-notes'));
  window.addEventListener('storage', (e) => {
    if (e.key === STORAGE_PREFIX + NOTES_KEY) renderNotes();
  });
  renderNotes();

  renderBookmarks();
  window.addEventListener(CHANGE_EVENT, renderBookmarks);
  window.addEventListener('storage', renderBookmarks);
</script>
