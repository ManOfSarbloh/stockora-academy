---
/** Chart Reading Quiz: questions on simulated charts, including click-on-the-chart answers. */
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/PageHeader.astro';
import ChartQuiz from '@/components/chartlab/ChartQuiz';
import patterns from '../../../content/candles.json';
import { t } from '@/i18n';
import { url } from '@/lib/url';
---

<BaseLayout title={t('cq.title')} description={t('cq.lead')}>
  <PageHeader title={t('cq.title')} lead={t('cq.lead')} eyebrow={t('nav.charts')}>
    <p class="mt-4 text-sm">
      <a href={url('/charts')}>← {t('cc.backToSchool')}</a> · <a href={url('/charts/lab')}>{t('cl.title')}</a>
    </p>
  </PageHeader>
  <div class="container-page max-w-4xl py-8" data-pagefind-ignore>
    <ChartQuiz client:only="react" patterns={patterns as never}>
      <div slot="fallback" class="island-fallback h-[650px] lg:h-[730px]"></div>
    </ChartQuiz>
    <noscript><p class="card p-4 text-muted">The quiz needs JavaScript.</p></noscript>
    <p class="mt-8 text-sm text-muted">{t('cs.disclaimer')}</p>
  </div>
</BaseLayout>
