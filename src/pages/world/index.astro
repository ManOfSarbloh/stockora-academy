---
/**
 * World Markets hub: clickable map, country cards by region, links to the comparison page and lessons.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/PageHeader.astro';
import WorldMap from '@/components/world/WorldMap.astro';
import { getCountries, countryHref, marketSize, REGION_ORDER } from '@/lib/countries';
import { t } from '@/i18n';
import type { UiKey } from '@/i18n/en';
import { url } from '@/lib/url';

const countries = await getCountries();
const regions = REGION_ORDER.filter((r) => countries.some((c) => c.region === r));
---

<BaseLayout title={t('wm.title')} description={t('wm.lead')}>
  <PageHeader title={t('wm.title')} lead={t('wm.lead')} eyebrow={t('wm.eyebrow')}>
    <p class="mt-4 flex flex-wrap gap-3 text-sm">
      <a href={url('/world/compare')} class="btn btn-primary">{t('wm.compare')}</a>
      <a href={url('/learn/world-markets')} class="btn btn-ghost">{t('wm.learn')}</a>
    </p>
  </PageHeader>

  <div class="container-page py-10">
    <WorldMap countries={countries} />

    <h2 class="mt-12 text-2xl font-bold">{t('wm.countries')}</h2>
    {
      regions.map((r) => (
        <section class="mt-6" aria-labelledby={`region-${r}`}>
          <h3 id={`region-${r}`} class="text-lg font-semibold text-muted">
            {t(`tt.region.${r}` as UiKey)}
          </h3>
          <ul class="mt-3 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
            {countries
              .filter((c) => c.region === r)
              .map((c) => {
                const size = marketSize(c.code);
                return (
                  <li>
                    <a href={url(countryHref(c.code))} class="card block h-full p-4 no-underline hover:border-link">
                      <span class="flex items-baseline justify-between gap-2">
                        <span class="font-bold text-text">{c.name}</span>
                        <span class="text-xs text-muted">{c.currency.code}</span>
                      </span>
                      <span class="mt-1 block text-sm text-muted">
                        {c.exchanges.map((e) => e.name.replace(/ \(.*\)$/, '')).join(', ')}
                      </span>
                      <span class="mt-1 block text-sm text-muted">
                        {c.indexes[0].name.replace(/ \(.*\)$/, '')}
                        {size.listedCompanies && <> · {size.listedCompanies.value.toLocaleString('en-GB')} listed companies ({size.listedCompanies.year})</>}
                      </span>
                      {c.home && <span class="mt-2 inline-block rounded-full bg-surface-2 px-2 py-0.5 text-xs font-semibold text-link">{t('wm.home')}</span>}
                    </a>
                  </li>
                );
              })}
          </ul>
        </section>
      ))
    }
  </div>
</BaseLayout>
