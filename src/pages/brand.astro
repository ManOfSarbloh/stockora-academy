---
/** Internal page for choosing the logo (Phase 2 review). Not linked in navigation, not indexed. */
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/PageHeader.astro';
import LogoMark from '@/components/LogoMark.astro';
import { logoVariants, logoVariant } from '@/config/brand';
---

<BaseLayout localized={false} title="Logo options" searchable={false} noindex>
  <PageHeader
    title="Logo options"
    lead="Three original concepts for Stockora Academy. Each is shown large, as a wordmark, as a favicon, and on light and dark backgrounds."
  />
  <div class="container-page grid gap-6 py-10 lg:grid-cols-3">
    {
      logoVariants.map((v) => (
        <section class="card overflow-hidden" aria-labelledby={`logo-${v.id}`}>
          <div class="flex items-center justify-between px-5 pt-5">
            <h2 id={`logo-${v.id}`} class="text-lg font-bold">{v.name}</h2>
            {v.id === logoVariant && (
              <span class="rounded-full bg-surface-2 px-2.5 py-0.5 text-xs font-semibold text-link">Currently in use</span>
            )}
          </div>
          <p class="px-5 pt-1 text-sm text-muted">{v.idea}</p>

          <div class="mt-5 flex justify-center py-6">
            <LogoMark variant={v.id} size={120} />
          </div>

          <div class="grid grid-cols-2">
            <div class="flex items-center gap-2 bg-[#f9f4f5] p-4 [--mark-accent:#6a55a0] [--mark-body:#0b132b]">
              <LogoMark variant={v.id} size={28} />
              <span class="leading-none text-[#1a2433]">
                <span class="block text-sm font-bold">Stockora</span>
                <span class="block text-[0.6rem] font-semibold tracking-[0.18em] text-[#55418c] uppercase">Academy</span>
              </span>
            </div>
            <div class="flex items-center gap-2 bg-[#0b132b] p-4 [--mark-accent:#c8b8db] [--mark-body:#f9f4f5]">
              <LogoMark variant={v.id} size={28} />
              <span class="leading-none text-[#e6edf5]">
                <span class="block text-sm font-bold">Stockora</span>
                <span class="block text-[0.6rem] font-semibold tracking-[0.18em] text-[#c8b8db] uppercase">Academy</span>
              </span>
            </div>
          </div>

          <div class="flex items-center gap-4 border-t border-border px-5 py-4 text-sm text-muted">
            <span>Favicon sizes:</span>
            <LogoMark variant={v.id} size={16} />
            <LogoMark variant={v.id} size={24} />
            <LogoMark variant={v.id} size={32} />
          </div>
        </section>
      ))
    }
  </div>
</BaseLayout>
