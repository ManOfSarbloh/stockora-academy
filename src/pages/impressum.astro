---
import ProseLayout from '@/layouts/ProseLayout.astro';
import Callout from '@/components/Callout.astro';
---

<ProseLayout title="Impressum" lead="Legal notice / Offenlegung." noindex>
  <Callout kind="verify" title="Placeholder: to be completed by the site owner">
    <p>
      Websites published from Austria commonly need an Impressum (legal notice). Which details are required depends on
      the situation (for example private or commercial website). The site owner must check the exact requirements, for
      example in the Austrian legal information system <a href="https://www.ris.bka.gv.at/">RIS</a> or with the
      Wirtschaftskammer or a lawyer, and fill in real details below.
    </p>
  </Callout>

  <h2>Media owner and publisher (Medieninhaber und Herausgeber)</h2>
  <p>[Name]<br />[Address]<br />[Country]</p>

  <h2>Contact</h2>
  <p>[Email address]</p>

  <h2>Purpose of the website (Blattlinie)</h2>
  <p>
    Stockora Academy is a free educational website explaining stocks, trading and stock markets. It does not provide
    investment, tax or legal advice.
  </p>
</ProseLayout>
