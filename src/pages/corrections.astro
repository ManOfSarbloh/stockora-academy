---
import ProseLayout from '@/layouts/ProseLayout.astro';
import Callout from '@/components/Callout.astro';
---

<ProseLayout
  title="Corrections"
  lead="Found a mistake? Thank you, please tell us. Fixed errors are listed here."
  lastUpdated="2026-10-11"
>
  <h2>How to report a mistake</h2>
  <p>Every quiz question and lesson will have a "Report a mistake" link. When you report something, please include:</p>
  <ul>
    <li>the page address (URL),</li>
    <li>what is wrong, and</li>
    <li>if possible, an official source that shows the correct information.</li>
  </ul>
  <Callout kind="verify" title="To be set up">
    <p>The reporting channel (a GitHub issue form or an email address) will be added when the site is published.</p>
  </Callout>

  <h2>Corrections log</h2>
  <p>No corrections yet.</p>
</ProseLayout>
