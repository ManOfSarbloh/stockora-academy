---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/PageHeader.astro';
import WorldGame from '@/components/quiz/WorldGame';
import { getCountries } from '@/lib/countries';
import { buildWorldMap } from '@/lib/world-map';
import { t } from '@/i18n';
import { url } from '@/lib/url';

const countries = (await getCountries()).map((c) => ({
  code: c.code,
  name: c.name,
  indexes: c.indexes.map((i) => i.name),
  currency: { code: c.currency.code, name: c.currency.name },
}));
const map = buildWorldMap();
// Only countries with a page keep their code; the rest are background shapes.
const codes = new Set(countries.map((c) => c.code));
const shapes = map.shapes.map((s) => ({ code: s.code && codes.has(s.code) ? s.code : null, d: s.d }));
---

<BaseLayout title={t('wg.title')} description={t('wg.lead')}>
  <PageHeader title={t('wg.title')} lead={t('wg.lead')}>
    <p class="mt-3 text-sm"><a href={url('/quizzes')}>← {t('quiz.toHub')}</a> · <a href={url('/world')}>{t('nav.world')} →</a></p>
  </PageHeader>
  <div class="container-page max-w-4xl py-10" data-pagefind-ignore>
    <WorldGame client:only="react" countries={countries} map={{ width: map.width, height: map.height, shapes, markers: map.markers.filter((m) => codes.has(m.code)) }}>
      <div slot="fallback" class="island-fallback h-[750px] lg:h-[560px]"></div>
    </WorldGame>
    <noscript><p class="card p-4 text-muted">The game needs JavaScript.</p></noscript>
  </div>
</BaseLayout>
