---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/PageHeader.astro';

interface Props {
  title: string;
  lead?: string;
  description?: string;
  lastUpdated?: string;
  noindex?: boolean;
}

const { title, lead, description = lead, lastUpdated, noindex = false } = Astro.props;
---

<BaseLayout title={title} description={description} noindex={noindex}>
  <PageHeader title={title} lead={lead} />
  <div class="container-page py-10">
    <article class="prose prose-stockora max-w-3xl prose-headings:tracking-tight prose-a:font-medium">
      <slot />
      {lastUpdated && <p class="text-sm text-muted">Last updated: {lastUpdated}</p>}
    </article>
  </div>
</BaseLayout>
