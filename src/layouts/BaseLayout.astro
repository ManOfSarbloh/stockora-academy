---
import '@fontsource-variable/inter';
import '@/styles/global.css';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import GlossaryTooltip from '@/components/GlossaryTooltip.astro';
import { getLocale, intlLocale, t } from '@/i18n';
import { ACTIVE_LOCALES } from '@/i18n/pages';
import { isEnglishOnly, localizePath, stripLocale } from '@/i18n/routes';
import { absoluteUrl, stripBase, url } from '@/lib/url';
import { toScript, type JsonLd } from '@/lib/seo';

interface Props {
  title?: string;
  description?: string;
  /** Exclude a page from the Pagefind search index. */
  searchable?: boolean;
  noindex?: boolean;
  /** "article" for lessons; everything else is a "website" page. */
  ogType?: 'website' | 'article';
  /** ISO date the content was last reviewed (articles only). */
  modified?: string;
  /** schema.org structured data for this page. */
  jsonLd?: JsonLd | JsonLd[];
  /** False for pages that exist in English only, outside src/pages/[...locale]/ (404, logo options). */
  localized?: boolean;
}

const { title, description = t('site.description'), searchable = true, noindex = false, ogType = 'website', modified, jsonLd, localized = true } = Astro.props;
const siteName = t('site.name');
const fullTitle = title ? `${title} | ${siteName}` : `${siteName}: ${t('site.tagline')}`;
const locale = getLocale();
const path = stripBase(import.meta.env.BASE_URL, Astro.url.pathname);
const route = stripLocale(path === '/' ? '/' : `${path}/`);
// Pages whose main content is English only (lessons, country data, …) point search engines to the
// English original and list no translations; fully translated pages list every language.
const englishOnly = isEnglishOnly(route);
const canonical = englishOnly ? absoluteUrl(route, Astro.site, 'en') : new URL(Astro.url.pathname, Astro.site).href;
const alternates = englishOnly || noindex || !localized || ACTIVE_LOCALES.length < 2 ? [] : ACTIVE_LOCALES.map((l) => ({ lang: l, href: absoluteUrl(route, Astro.site, l) }));
const ogImage = new URL(url('/og-default.png'), Astro.site);
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {alternates.map((a) => <link rel="alternate" hreflang={a.lang} href={a.href} />)}
    {alternates.length > 1 && <link rel="alternate" hreflang="x-default" href={alternates[0].href} />}
    {locale !== 'en' && <script is:inline src={url(`/i18n/${locale}.js`)} />}
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content={intlLocale[locale].replace('-', '_')} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={t('site.ogImageAlt')} />
    {ogType === 'article' && modified && <meta property="article:modified_time" content={modified} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#0f2a44" />
    <link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />
    <link rel="sitemap" href={url('/sitemap-index.xml')} />
    {jsonLd && <script type="application/ld+json" set:html={toScript(jsonLd)} />}
    <script is:inline>
      // Apply the saved or system colour theme before the page paints (avoids a flash).
      (function () {
        var pref = null;
        try { pref = localStorage.getItem('stockora-theme'); } catch (e) {}
        var dark = pref ? pref === 'dark' : window.matchMedia('(prefers-color-scheme: dark)').matches;
        document.documentElement.classList.toggle('dark', dark);
      })();
    </script>
  </head>
  <body class="flex min-h-screen flex-col">
    <a
      href="#main"
      class="sr-only z-50 rounded-md bg-surface px-4 py-2 font-semibold focus:not-sr-only focus:fixed focus:top-3 focus:left-3"
    >
      {t('a11y.skipToContent')}
    </a>
    <Header localized={localized} />
    <main id="main" class="flex-1" data-pagefind-body={searchable ? '' : undefined} tabindex="-1">
      {
        englishOnly && locale !== 'en' && (
          <p class="border-b border-border bg-surface-2 px-4 py-2 text-center text-sm text-muted" data-pagefind-ignore>
            {t('i18n.englishOnly')}{' '}
            <a href={url(route, 'en')} hreflang="en" lang="en">
              English
            </a>
          </p>
        )
      }
      <slot />
    </main>
    <Footer />
    <GlossaryTooltip />
  </body>
</html>
