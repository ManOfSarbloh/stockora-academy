---
/**
 * Decorative banner art for page headers: one illustration from the icon set on soft brand circles,
 * a dot grid and a rising line. Colours come from CSS variables (light and dark mode). Hidden from
 * screen readers and on small screens.
 */
import { ICONS, type IconName } from './icons';

interface Props {
  name: IconName;
  class?: string;
}
const { name, class: className } = Astro.props;
const dots: [number, number][] = [];
for (let r = 0; r < 5; r++) for (let c = 0; c < 6; c++) dots.push([18 + c * 13, 22 + r * 13]);
---

<svg viewBox="0 0 260 190" class:list={['hero-art', className]} aria-hidden="true" focusable="false">
  <g fill="var(--muted)" opacity=".35">{dots.map(([x, y]) => <circle cx={x} cy={y} r="1.6" />)}</g>
  <circle cx="160" cy="98" r="84" fill="var(--teal)" opacity=".08"></circle>
  <circle cx="160" cy="98" r="60" fill="var(--teal)" opacity=".1"></circle>
  <path
    d="M8 172c22 0 30-18 52-18s28 10 50 6 30-26 54-28 30 8 52 2 30-22 40-30"
    fill="none"
    stroke="var(--teal)"
    stroke-width="2.5"
    stroke-linecap="round"
    opacity=".55"></path>
  <g fill="var(--teal)" opacity=".7"><circle cx="110" cy="160" r="3.5"></circle><circle cx="216" cy="132" r="3.5"></circle></g>
  <rect x="207" y="22" width="34" height="34" rx="9" fill="var(--surface)" stroke="var(--border)"></rect>
  <path d="m215 44 6-7 5 4 8-9" fill="none" stroke="var(--teal)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"></path>
  <svg
    x="108"
    y="46"
    width="104"
    height="104"
    viewBox="0 0 48 48"
    fill="none"
    stroke="var(--text)"
    stroke-width="2.1"
    stroke-linecap="round"
    stroke-linejoin="round"
    set:html={ICONS[name]}
  />
</svg>
