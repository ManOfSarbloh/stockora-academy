---
/**
 * Callout box for Astro pages. Lessons use the Markdown form instead (`> [!EXAMPLE]`);
 * both share the same styles in global.css.
 */
import { CALLOUT_KINDS, type CalloutKind } from '@/lib/markdown/callouts';

interface Props {
  kind?: CalloutKind;
  title?: string;
}

const { kind = 'note', title = CALLOUT_KINDS[kind] } = Astro.props;
---

<aside class:list={['callout', `callout-${kind}`, 'not-prose']} aria-label={title}>
  <p class="callout-title">{title}</p>
  <div class="text-[0.95rem] [&_a]:font-medium [&>*+*]:mt-2"><slot /></div>
</aside>
