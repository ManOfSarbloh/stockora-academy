---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/PageHeader.astro';
import { plannedSections } from '@/config/site';
import { t } from '@/i18n';
import { url } from '@/lib/url';

interface Props {
  section: keyof typeof plannedSections;
}

const s = plannedSections[Astro.props.section];
---

<BaseLayout title={s.title} description={s.lead} searchable={false}>
  <PageHeader title={s.title} lead={s.lead} />
  <div class="container-page py-10">
    <div class="card max-w-2xl p-6">
      <span class="inline-block rounded-full bg-surface-2 px-2.5 py-0.5 text-xs font-semibold text-link">{t('soon.badge')}</span>
      <h2 class="mt-3 text-xl font-bold">{t('soon.title')}</h2>
      <p class="mt-1 text-muted">{t('soon.body')}</p>
      <h3 class="mt-5 font-semibold">{t('soon.planned')}</h3>
      <ul class="mt-2 list-disc space-y-1 pl-5">
        {s.planned.map((p) => <li>{p}</li>)}
      </ul>
      <a href={url('/learn')} class="btn btn-ghost mt-6">{t('home.hero.browse')}</a>
    </div>
  </div>
</BaseLayout>
