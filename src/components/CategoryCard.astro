---
import type { Category } from '@/lib/categories';
import { t } from '@/i18n';
import { url } from '@/lib/url';
import Icon from '@/components/art/Icon.astro';
import { topicIcon } from '@/components/art/icons';

interface Props {
  category: Category;
  step?: number;
  /** Lesson keys of this category; the progress ring is filled in by ProgressScript. */
  lessonKeys?: string[];
}

const { category: c, step, lessonKeys = [] } = Astro.props;
const levelKey = { beginner: 'level.beginner', intermediate: 'level.intermediate', advanced: 'level.advanced' } as const;
const n = lessonKeys.length;
const R = 19;
const C = +(2 * Math.PI * R).toFixed(2);
---

<a
  href={url(`/learn/${c.slug}`)}
  class="card group flex h-full gap-4 p-4 text-text no-underline transition-colors hover:border-link sm:p-5"
  data-progress-keys={lessonKeys.join(' ')}
>
  <span class="relative h-12 w-12 shrink-0" aria-hidden="true">
    <svg viewBox="0 0 44 44" class="h-12 w-12 -rotate-90">
      <circle cx="22" cy="22" r={R} fill="none" stroke="var(--border)" stroke-width="3.5"></circle>
      <circle
        class="progress-arc transition-[stroke-dashoffset] duration-500"
        cx="22"
        cy="22"
        r={R}
        fill="none"
        stroke="var(--teal)"
        stroke-width="3.5"
        stroke-linecap="round"
        stroke-dasharray={C}
        stroke-dashoffset={C}
        data-circumference={C}></circle>
    </svg>
    <span class="absolute inset-0 flex items-center justify-center text-text group-hover:text-link"><Icon name={topicIcon(c.id)} size={26} strokeWidth={2.8} /></span>
  </span>
  <span class="min-w-0">
    {step && <span class="block text-xs font-semibold text-muted">{t('learn.pathStep')} {step}</span>}
    <span class="block font-semibold group-hover:text-link"><span class="mr-1.5 inline-flex h-5 min-w-5 items-center justify-center rounded bg-surface-2 px-1 align-[1px] text-xs font-bold text-muted">{c.id}</span>{c.title}</span>
    <span class="mt-1 block text-sm text-muted">{c.summary}</span>
    <span class="mt-2 flex flex-wrap items-center gap-1.5">
      {
        c.levels.map((l) => (
          <span class="rounded-full bg-surface-2 px-2 py-0.5 text-xs font-medium text-muted">{t(levelKey[l])}</span>
        ))
      }
      {
        n > 0 && (
          <span class="progress-text ml-1 text-xs text-muted" data-label={t('learn.progressLabel')}>
            {n === 1 ? t('learn.lessonCountOne') : t('learn.lessonCount', { n })}
          </span>
        )
      }
    </span>
  </span>
</a>
