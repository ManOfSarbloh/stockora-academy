---
import HeroArt from '@/components/art/HeroArt.astro';
import type { IconName } from '@/components/art/icons';

interface Props {
  title: string;
  lead?: string;
  eyebrow?: string;
  /** Decorative illustration shown next to the title on wider screens. */
  art?: IconName;
}
const { title, lead, eyebrow, art } = Astro.props;
---

<div class="border-b border-border bg-surface">
  <div class:list={['container-page py-10 sm:py-14', art && 'md:flex md:items-center md:justify-between md:gap-10']}>
    <div class="min-w-0">
      {eyebrow && <p class="text-sm font-semibold tracking-wide text-link uppercase">{eyebrow}</p>}
      <h1 class="mt-1 text-3xl font-bold tracking-tight text-balance sm:text-4xl">{title}</h1>
      {lead && <p class="mt-3 max-w-2xl text-lg text-muted">{lead}</p>}
      <slot />
    </div>
    {art && <HeroArt name={art} class="hidden h-40 w-auto shrink-0 md:block lg:h-44" />}
  </div>
</div>
