---
import { getCollection } from 'astro:content';
import VideoCard from '@/components/VideoCard.astro';
import { t } from '@/i18n';

interface Props {
  /** Show videos linked to this lesson key... */
  lessonKey?: string;
  /** ...or all videos of this category. */
  categoryId?: string;
  /**
   * When no checked video exists, show a "Search YouTube" link for this query instead
   * (the brief: never invent a video link). Only used on topic pages.
   */
  fallbackQuery?: string;
  headingLevel?: 'h2' | 'h3';
}

const { lessonKey, categoryId, fallbackQuery, headingLevel: H = 'h2' } = Astro.props;
const videos = (await getCollection('videos'))
  .map((v) => v.data)
  .filter((v) => (lessonKey ? v.lessons.includes(lessonKey) : categoryId ? v.categories.includes(categoryId) : false));
const headingId = `videos-${(lessonKey ?? categoryId ?? 'list').replace(/[^a-z0-9-]/gi, '-')}`;
const searchUrl = fallbackQuery ? `https://www.youtube.com/results?search_query=${encodeURIComponent(fallbackQuery)}` : null;
---

{
  (videos.length > 0 || searchUrl) && (
    <section class="not-prose" aria-labelledby={headingId} data-pagefind-ignore>
      <H id={headingId} class="text-xl font-bold">
        {t('video.heading')}
      </H>
      <p class="mt-1 text-sm text-muted">{t('video.disclaimer')}</p>
      {videos.length > 0 ? (
        <div class="mt-4 grid gap-4 md:grid-cols-2">
          {videos.map((v) => (
            <VideoCard video={v} />
          ))}
        </div>
      ) : (
        <div class="card mt-4 p-5">
          <p class="text-sm text-muted">{t('video.noneYet')}</p>
          <a href={searchUrl} rel="noopener" target="_blank" class="btn btn-ghost mt-3 text-sm">
            {t('video.searchYouTube')} ↗
          </a>
        </div>
      )}
    </section>
  )
}
