---
import LogoMark from '@/components/LogoMark.astro';
import { primaryNav, secondaryNav } from '@/config/site';
import { getLocale, localeNames, t } from '@/i18n';
import { ACTIVE_LOCALES } from '@/i18n/pages';
import { stripLocale } from '@/i18n/routes';
import { stripBase, url } from '@/lib/url';

const { localized = true } = Astro.props as { localized?: boolean };
const locale = getLocale();
const current = stripLocale(stripBase(import.meta.env.BASE_URL, Astro.url.pathname)).replace(/(.)\/$/, '$1');
// The same page in each language (with a trailing slash, so the switcher keeps the full route).
const route = current === '/' ? '/' : `${current}/`;
const isActive = (href: string) => current === href || current.startsWith(`${href}/`);
const moreActive = secondaryNav.some((i) => isActive(i.href));
// On screens between lg and xl the full bar does not fit (longer labels in some languages), so the
// last primary items move into "More" there.
const LG_PRIMARY = 4;
const lgOverflow = primaryNav.slice(LG_PRIMARY);
const lgMoreActive = lgOverflow.some((i) => isActive(i.href));
---

<header class="on-sky header-sky sticky top-0 z-40">
  <div class="container-page flex h-16 items-center gap-4">
    <a href={url('/')} class="flex shrink-0 items-center gap-2.5 no-underline" aria-label={t('a11y.home')}>
      <LogoMark size={30} />
      <span class="leading-none text-text">
        <span class="block text-[1.05rem] font-bold tracking-tight">Stockora</span>
        <span class="block text-[0.7rem] font-semibold tracking-[0.18em] text-link uppercase">Academy</span>
      </span>
    </a>

    <nav aria-label={t('a11y.mainNav')} class="ml-2 hidden flex-1 items-center gap-0.5 lg:flex xl:ml-4 xl:gap-1">
      {
        primaryNav.map((item, i) => (
          <a
            href={url(item.href)}
            aria-current={isActive(item.href) ? 'page' : undefined}
            class:list={[i >= LG_PRIMARY && 'hidden xl:inline', 'rounded-md px-2 py-2 text-sm font-medium whitespace-nowrap xl:px-2.5 text-text no-underline hover:bg-surface-2 aria-[current=page]:text-link aria-[current=page]:underline aria-[current=page]:decoration-2 aria-[current=page]:underline-offset-[6px]']}
          >
            {t(item.label)}
          </a>
        ))
      }
      <details class="nav-menu nav-more relative">
        <summary
          class:list={[
            'flex cursor-pointer list-none items-center gap-1 rounded-md px-2 py-2 text-sm font-medium hover:bg-surface-2 xl:px-2.5',
            moreActive && 'text-link',
            !moreActive && lgMoreActive && 'max-xl:text-link',
          ]}
        >
          {t('nav.more')}
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg>
        </summary>
        <div class="card absolute top-full right-0 mt-2 w-52 p-1.5 shadow-lg">
          {
            lgOverflow.map((item) => (
              <a
                href={url(item.href)}
                aria-current={isActive(item.href) ? 'page' : undefined}
                class="block rounded-md px-3 py-2 text-sm text-text no-underline hover:bg-surface-2 aria-[current=page]:font-semibold aria-[current=page]:text-link xl:hidden"
              >
                {t(item.label)}
              </a>
            ))
          }
          {
            secondaryNav.map((item) => (
              <a
                href={url(item.href)}
                aria-current={isActive(item.href) ? 'page' : undefined}
                class="block rounded-md px-3 py-2 text-sm text-text no-underline hover:bg-surface-2 aria-[current=page]:font-semibold aria-[current=page]:text-link"
              >
                {t(item.label)}
              </a>
            ))
          }
        </div>
      </details>
    </nav>

    <div class="ml-auto flex items-center gap-0.5 xl:gap-1">
      <a
        href={url('/me')}
        class="inline-flex h-10 w-10 items-center justify-center rounded-md text-text hover:bg-surface-2 aria-[current=page]:text-link"
        aria-label={t('nav.me')}
        title={t('nav.me')}
        aria-current={isActive('/me') ? 'page' : undefined}
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" aria-hidden="true"><path d="M6 3h12v18l-6-4-6 4z"></path></svg>
      </a>
      <a
        href={url('/search')}
        class="inline-flex h-10 w-10 items-center justify-center rounded-md text-text hover:bg-surface-2"
        aria-label={t('nav.search')}
        aria-keyshortcuts="/"
        title={`${t('nav.search')} (/)`}
        data-search-link
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path></svg>
      </a>
      {
        localized && ACTIVE_LOCALES.length > 1 && (
          <details class="nav-menu nav-lang relative">
            <summary
              class="flex h-10 cursor-pointer list-none items-center gap-1 rounded-md px-2 text-sm font-semibold text-text uppercase hover:bg-surface-2"
              aria-label={`${t('i18n.language')}: ${localeNames[locale]}`}
              title={t('i18n.language')}
            >
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M3 12h18M12 3a14 14 0 0 1 0 18M12 3a14 14 0 0 0 0 18"></path></svg>
              {locale}
            </summary>
            <ul class="card absolute top-full right-0 mt-2 w-44 p-1.5 shadow-lg">
              {ACTIVE_LOCALES.map((l) => (
                <li>
                  <a
                    href={url(route, l)}
                    hreflang={l}
                    lang={l}
                    aria-current={l === locale ? 'true' : undefined}
                    class="block rounded-md px-3 py-2 text-sm text-text no-underline hover:bg-surface-2 aria-[current=true]:font-semibold aria-[current=true]:text-link"
                  >
                    {localeNames[l]}
                  </a>
                </li>
              ))}
            </ul>
          </details>
        )
      }
      <button
        type="button"
        id="theme-toggle"
        class="inline-flex h-10 w-10 items-center justify-center rounded-md text-text hover:bg-surface-2"
        aria-label={t('theme.toggle')}
        title={t('theme.toggle')}
      >
        <svg class="hidden dark:block" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path></svg>
        <svg class="block dark:hidden" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"></path></svg>
      </button>
      <button
        type="button"
        id="menu-toggle"
        class="inline-flex h-10 w-10 items-center justify-center rounded-md text-text hover:bg-surface-2 lg:hidden"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label={t('a11y.openMenu')}
        data-label-open={t('a11y.openMenu')}
        data-label-close={t('a11y.closeMenu')}
      >
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"></path></svg>
      </button>
    </div>
  </div>

  <nav id="mobile-menu" aria-label={t('a11y.mainNav')} class="band-sky hidden border-t border-border lg:hidden">
    <ul class="container-page grid gap-0.5 py-3 sm:grid-cols-2">
      {
        [...primaryNav, ...secondaryNav].map((item) => (
          <li>
            <a
              href={url(item.href)}
              aria-current={isActive(item.href) ? 'page' : undefined}
              class="block rounded-md px-3 py-2.5 font-medium text-text no-underline hover:bg-surface-2 aria-[current=page]:text-link"
            >
              {t(item.label)}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<script>
  // "/" opens the search from anywhere (or focuses the box on the search page), unless the visitor is typing.
  document.addEventListener('keydown', (e) => {
    if (e.key !== '/' || e.ctrlKey || e.metaKey || e.altKey || e.defaultPrevented) return;
    const target = e.target as HTMLElement | null;
    if (target?.closest('input, textarea, select, [contenteditable]:not([contenteditable="false"])')) return;
    const link = document.querySelector<HTMLAnchorElement>('a[data-search-link]');
    if (!link) return;
    e.preventDefault();
    const box = document.getElementById('search-input');
    if (box) box.focus();
    else location.href = link.href;
  });

  import { STORAGE_PREFIX } from '@/lib/storage';

  const themeBtn = document.getElementById('theme-toggle');

  // Browser UI colour (address bar on mobile): the header's blue.
  const THEME_COLOR = { light: '#0099ff', dark: '#0a3560' };

  function applyTheme() {
    const root = document.documentElement;
    const dark = root.classList.toggle('dark');
    document.querySelector('meta[name="theme-color"]')?.setAttribute('content', dark ? THEME_COLOR.dark : THEME_COLOR.light);
    // The pre-paint script in BaseLayout reads this raw string (not JSON).
    try {
      localStorage.setItem(`${STORAGE_PREFIX}theme`, dark ? 'dark' : 'light');
    } catch {
      /* storage blocked: the theme still applies for this page view */
    }
  }

  const RAYS = Array.from({ length: 8 }, (_, i) => {
    const a = (i * Math.PI) / 4;
    const p = (r: number) => `${(Math.cos(a) * r).toFixed(1)} ${(Math.sin(a) * r).toFixed(1)}`;
    return `<path d="M${p(27)}L${p(38)}"/>`;
  }).join('');
  const SUN = `<svg viewBox="-50 -50 100 100"><defs><radialGradient id="tfx-halo"><stop offset="0" stop-color="#ffe9a0" stop-opacity=".9"/><stop offset="1" stop-color="#ffe9a0" stop-opacity="0"/></radialGradient><radialGradient id="tfx-sun"><stop offset="0" stop-color="#fff7d1"/><stop offset=".55" stop-color="#ffd447"/><stop offset="1" stop-color="#ffb300"/></radialGradient></defs><circle r="50" fill="url(#tfx-halo)"/><g stroke="#ffc22e" stroke-width="5" stroke-linecap="round">${RAYS}</g><circle r="20" fill="url(#tfx-sun)"/></svg>`;
  const MOON = `<svg viewBox="-50 -50 100 100"><defs><radialGradient id="tfx-glow"><stop offset="0" stop-color="#b8d4ff" stop-opacity=".45"/><stop offset="1" stop-color="#b8d4ff" stop-opacity="0"/></radialGradient><mask id="tfx-cut"><rect x="-50" y="-50" width="100" height="100" fill="#fff"/><circle cx="11" cy="-9" r="19" fill="#000"/></mask></defs><circle r="46" fill="url(#tfx-glow)"/><circle r="22" fill="#f4f1e6" mask="url(#tfx-cut)"/></svg>`;

  let switching = false;

  function animateSwitch(btn: HTMLElement) {
    const root = document.documentElement;
    const toDark = !root.classList.contains('dark');
    const box = btn.getBoundingClientRect();
    const x = box.left + box.width / 2;
    const y = box.top + box.height / 2;
    const radius = Math.hypot(Math.max(x, innerWidth - x), Math.max(y, innerHeight - y)) * 1.1;
    const at = `${x}px ${y}px`;

    const fx = document.createElement('div');
    fx.className = 'theme-fx';
    fx.setAttribute('aria-hidden', 'true');
    const wash = document.createElement('div');
    wash.className = 'theme-fx-wash';
    // Sunlight: warm white spreading out; night: deep blue fading to near-black.
    wash.style.background = toDark
      ? `radial-gradient(circle at ${at}, rgb(10 53 96 / 0.96) 0, rgb(7 11 17 / 0.97) 45%)`
      : `radial-gradient(circle at ${at}, rgb(255 250 225 / 0.98) 0, rgb(255 241 190 / 0.95) 30%, rgb(253 253 254 / 0.94) 65%)`;
    const orb = document.createElement('div');
    orb.className = 'theme-fx-orb';
    orb.style.left = `${x}px`;
    orb.style.top = `${y}px`;
    orb.style.filter = toDark ? 'drop-shadow(0 0 10px rgb(184 212 255 / 0.6))' : 'drop-shadow(0 0 16px rgb(255 196 46 / 0.9))';
    orb.innerHTML = toDark ? MOON : SUN;
    fx.append(wash, orb);

    const stars: HTMLElement[] = [];
    if (toDark) {
      for (let i = 0; i < 18; i++) {
        const star = document.createElement('span');
        star.className = 'theme-fx-star';
        star.style.left = `${Math.random() * 100}%`;
        star.style.top = `${Math.random() * 70}%`;
        fx.append(star);
        stars.push(star);
      }
    }
    document.body.append(fx);

    const DURATION = 1300;
    const DELAY = 180;
    orb.animate(
      [
        { opacity: 0, transform: `scale(0.3) ${toDark ? 'translateY(-14px)' : 'rotate(-90deg)'}` },
        { opacity: 1, transform: `scale(1.35) ${toDark ? 'translateY(0)' : 'rotate(0deg)'}`, offset: 0.28, easing: 'ease-in-out' },
        { opacity: 1, transform: `scale(1.15) ${toDark ? 'translateY(0)' : 'rotate(25deg)'}`, offset: 0.72 },
        { opacity: 0, transform: `scale(0.55) ${toDark ? 'translateY(0)' : 'rotate(45deg)'}` },
      ],
      { duration: DURATION + DELAY, easing: 'cubic-bezier(0.34, 1.4, 0.64, 1)' },
    );
    const spread = wash.animate(
      [
        { opacity: 1, clipPath: `circle(0px at ${at})` },
        { opacity: 1, clipPath: `circle(${radius}px at ${at})`, offset: 0.5 },
        { opacity: 1, clipPath: `circle(${radius}px at ${at})`, offset: 0.6 },
        { opacity: 0, clipPath: `circle(${radius}px at ${at})` },
      ],
      { duration: DURATION, delay: DELAY, easing: 'cubic-bezier(0.4, 0, 0.2, 1)', fill: 'backwards' },
    );
    for (const star of stars) {
      star.animate([{ opacity: 0 }, { opacity: 1 }, { opacity: 0 }], {
        duration: 600 + Math.random() * 400,
        delay: DELAY + 250 + Math.random() * 450,
        easing: 'ease-in-out',
      });
    }

    // Change the theme while the light or shadow covers the page.
    setTimeout(() => {
      root.classList.add('theme-fade', 'theme-switching');
      applyTheme();
      setTimeout(() => root.classList.remove('theme-fade', 'theme-switching'), 600);
    }, DELAY + DURATION * 0.48);

    const done = () => {
      fx.remove();
      switching = false;
    };
    spread.finished.then(done, done);
  }

  themeBtn?.addEventListener('click', () => {
    if (switching) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches || !document.body.animate) {
      applyTheme();
      return;
    }
    switching = true;
    animateSwitch(themeBtn);
  });

  const menuBtn = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  menuBtn?.addEventListener('click', () => {
    const open = menuBtn.getAttribute('aria-expanded') !== 'true';
    menuBtn.setAttribute('aria-expanded', String(open));
    menuBtn.setAttribute('aria-label', (open ? menuBtn.dataset.labelClose : menuBtn.dataset.labelOpen) ?? '');
    menu?.classList.toggle('hidden', !open);
  });

  // Close the "More" and language dropdowns when clicking elsewhere or pressing Escape.
  const menus = [...document.querySelectorAll<HTMLDetailsElement>('details.nav-menu')];
  document.addEventListener('click', (e) => {
    for (const m of menus) if (m.open && !m.contains(e.target as Node)) m.open = false;
  });
  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    for (const m of menus) {
      if (!m.open) continue;
      m.open = false;
      m.querySelector('summary')?.focus();
    }
  });
</script>
